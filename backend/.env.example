# Copy this file to `.env` (already git-ignored) and fill in real values there.
# Never commit `.env` itself — it holds real secrets.

# --- Core ---
# NETGUARD_ENV=development
# NETGUARD_DATABASE_URL=sqlite:///./data/netguard.db
# NETGUARD_SECRET_KEY=                     # required in production, 32+ chars

# --- Access control ---
# Set to false once your account(s) exist, so no one else can self-register.
# The very first account to register always becomes admin regardless of this setting.
NETGUARD_ALLOW_REGISTRATION=true

# --- AI explain/fix (optional; falls back to rule-based explanations without a key) ---
# Exactly one of these three is used, in this priority order: Anthropic, Groq, Gemini.
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# NETGUARD_AI_PROVIDER=auto                # auto | anthropic | groq | gemini

# --- Network/API scanning ---
# NETGUARD_ALLOW_PUBLIC_TARGETS=false      # must opt in to scan public IPs/hosts
